# Copy to .env (install.sh does this for you) and edit.
# NOTE: this file was not included in the compiled dump - it is rebuilt from the
# variables the code reads. Merge with your own if it has extra entries.

# ---- Database (SQLite) ----------------------------------------------------
# Relative paths are resolved from the project root (the folder containing
# admin-php/, fastapi-service/ and data/). Both FastAPI and the PHP admin
# panel read this same variable, so they always open the same file.
DB_PATH=data/mfano_bora_chatbot.db
# Seconds a writer waits for a lock before giving up (FastAPI side).
DB_BUSY_TIMEOUT_SECONDS=5

# ---- Groq LLM -------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Retrieval ------------------------------------------------------------
TOP_K_RESULTS=3

# ---- API / CORS -----------------------------------------------------------
ALLOWED_ORIGINS=https://www.mfanoboraafrica.com,https://mfanoboraafrica.com
APP_ENV=production
CONTACT_EMAIL=info@mfanoboraafrica.com

# ---- PHP admin panel ------------------------------------------------------
ADMIN_SESSION_NAME=mfano_admin_sess
ADMIN_SESSION_LIFETIME=3600
