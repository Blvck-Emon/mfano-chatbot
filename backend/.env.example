# =====================================================================
# Copy this file to .env at the project root AND to fastapi-service/.env
# admin-php reads the same variable names from admin-php/config/.env
# (config/config.php loads it) -- keep all three files in sync.
# =====================================================================

# --- MySQL (shared by FastAPI + PHP admin) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mfano_bora_chatbot
DB_USER=mfano_app
DB_PASSWORD=change_this_password

# --- Groq LLM (FastAPI only) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Retrieval tuning (FastAPI only) ---
TOP_K_RESULTS=3

# --- CORS: comma separated list of origins allowed to call the API ---
ALLOWED_ORIGINS=https://www.mfanoboraafrica.com,https://mfanoboraafrica.com

# --- App ---
APP_ENV=production
CONTACT_EMAIL=info@mfanoboraafrica.com

# --- PHP admin session ---
ADMIN_SESSION_NAME=mfano_admin_sess
ADMIN_SESSION_LIFETIME=3600
